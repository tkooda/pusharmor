{
  "manifest_version": 3,
  "name": "PushArmor",
  "version": "0.0.1",
  "description": "Send links and text between your own devices, end-to-end encrypted.",
  "minimum_chrome_version": "121",
  "background": { "service_worker": "sw.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_icon": { "128": "icons/icon-128.png" } },
  "icons": { "128": "icons/icon-128.png" },
  "permissions": ["notifications", "contextMenus", "storage", "activeTab", "identity", "alarms", "unlimitedStorage", "scripting"],
  "host_permissions": ["https://api.pusharmor.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://pusharmor.com"
  }
}
