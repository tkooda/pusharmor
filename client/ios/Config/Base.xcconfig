// Build ids: empty here; Public.xcconfig (git-ignored, derived) sets them. Write it
// from release/public.json with: sh tools/public-xcconfig.sh
// A Release build fails while one is empty (tools/check-release-values.sh).
DEVELOPMENT_TEAM =
GOOGLE_IOS_CLIENT_ID =
GOOGLE_CALLBACK_SCHEME =
#include? "Public.xcconfig"
