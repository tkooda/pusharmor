{
  "name": "pusharmor-site",
  "build": { "command": "node tools/build.mjs" },
  "compatibility_date": "2026-08-22",
  "assets": { "directory": "./public", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "pusharmor.com", "custom_domain": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "pusharmor", "database_id": "00000000-0000-0000-0000-000000000000" }]
}
