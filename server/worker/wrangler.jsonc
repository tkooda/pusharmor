// PushArmor Worker. Bindings and vars only; secrets are set with "wrangler secret put".
// Deployment ids (GOOGLE_*, APPLE_*, WEBPUSH_*, AWS_*, *_AUD_*, PA_OAUTH_REDIRECT_CHROME)
// are Cloudflare dashboard variables, never in this file; keep_vars keeps them on deploy.
// The D1 binding names the database; wrangler looks its id up by name.
{
  "name": "pusharmor-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "keep_vars": true,
  "preview_urls": false,
  "routes": [{ "pattern": "api.pusharmor.com", "custom_domain": true }],
  "limits": { "cpu_ms": 2000 },
  "triggers": { "crons": ["0 * * * *", "0 3 1 * *"] },
  // Workers Logs bills each line. head_sampling_rate stays 1 (head sampling is decided before
  // the request runs and would drop errors too). PA_LOG_SAMPLE samples plain successes and 429s
  // in code; errors are always logged. It is 1 (log all) during launch; see README "Logs".
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pusharmor",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "RL_IP", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
    { "name": "RL_PEER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_MAIL", "namespace_id": "1003", "simple": { "limit": 2, "period": 60 } },
    { "name": "RL_MAIL_ALL", "namespace_id": "1004", "simple": { "limit": 100, "period": 60 } },
    { "name": "RL_CODE", "namespace_id": "1005", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_PAIR", "namespace_id": "1006", "simple": { "limit": 1, "period": 60 } },
    { "name": "RL_PROBE", "namespace_id": "1007", "simple": { "limit": 2, "period": 60 } },
    { "name": "RL_CODE_ALL", "namespace_id": "1008", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_ACCT", "namespace_id": "1009", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "PA_ALLOWED_PUSH_ENDPOINT_PREFIXES": "[\"https://fcm.googleapis.com/fcm/send/\",\"https://fcm.googleapis.com/wp/\",\"https://updates.push.services.mozilla.com/wpush/v1/\",\"https://updates.push.services.mozilla.com/wpush/v2/\"]",
    "PA_PUSH_TTL_SECONDS": "604800",
    "PA_PUSH_PAIR_TTL_SECONDS": "2419200",
    "CLOUDFLARE_TURNSTILE_HOSTNAME": "pusharmor.com",
    "CLOUDFLARE_TURNSTILE_ACTION": "email",
    "PA_OAUTH_REDIRECT_FIREFOX": "https://pusharmor.com/auth/done",
    "PA_OAUTH_REDIRECT_ANDROID": "https://pusharmor.com/auth/android",
    "PA_OAUTH_REDIRECT_WEB": "https://pusharmor.com/delete-account",
    "PA_WEB_ORIGINS": "[\"https://pusharmor.com\"]",
    "PA_LOG_SAMPLE": "1"
  }
}
