// PushArmor Worker. Bindings and vars only; secrets are set with "wrangler secret put".
// Deployment ids (GOOGLE_*, APPLE_*, WEBPUSH_*, AWS_*, *_AUD_*, PA_OAUTH_REDIRECT_CHROME) and
// PA_LOG_SAMPLE and LOG_LEVEL are Cloudflare dashboard variables, never in this file; keep_vars keeps them on deploy.
// The D1 binding names the database; wrangler looks its id up by name.
// File sending: dashboard variables PA_FILE_DAY_LIMIT and PA_FILE_MONTH_LIMIT (uploads per account
// per UTC day and month; 0 pauses file sending; missing or not an integer also pauses it), secret
// FILE_ACCT_SECRET (b64url of 32 random bytes). File storage: secrets B2_KEY_ID and B2_APP_KEY;
// vars B2_BUCKET, B2_S3_ENDPOINT and B2_REGION below. Without all five, file sending is paused.
{
  "name": "pusharmor-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "keep_vars": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "api.pusharmor.com", "custom_domain": true },
    { "pattern": "b2file.pusharmor.com", "custom_domain": true }
  ],
  "limits": { "cpu_ms": 2000 },
  "triggers": { "crons": ["0 3 1 * *", "*/15 * * * *"] },
  // head_sampling_rate stays 1 (head sampling is decided before the request runs and would drop
  // errors too). PA_LOG_SAMPLE (a dashboard variable) samples plain successes and 4xx in code;
  // 5xx errors are always logged. See README "Logs".
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pusharmor",
      "migrations_dir": "migrations"
    }
  ],
  // RL_ACCT: 60 calls per 60 s per account (key "acct:" + account id) over every signed call
  // and POST /peers, checked before any D1 access. A real account (<= 10 devices, a few sends a
  // minute) stays far below it; one account can no longer multiply RL_PEER by its peers.
  "ratelimits": [
    { "name": "RL_IP", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
    { "name": "RL_PEER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_MAIL_EMAIL", "namespace_id": "1010", "simple": { "limit": 2, "period": 60 } },
    { "name": "RL_MAIL_IP", "namespace_id": "1011", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_MAIL_GLOBAL", "namespace_id": "1012", "simple": { "limit": 600, "period": 60 } },
    { "name": "RL_PAIR", "namespace_id": "1006", "simple": { "limit": 1, "period": 60 } },
    { "name": "RL_PROBE", "namespace_id": "1007", "simple": { "limit": 2, "period": 60 } },
    { "name": "RL_CODE", "namespace_id": "1013", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_ACCT", "namespace_id": "1009", "simple": { "limit": 60, "period": 60 } },
    // RL_FILE: POST /v1/file attempts per device (key "file:" + peer id).
    { "name": "RL_FILE", "namespace_id": "1014", "simple": { "limit": 5, "period": 60 } },
    // RL_DL_IP and RL_DL_KEY: file downloads on the file host, per IP (key "ip:" + IP or IPv6 /64)
    // and per object key (key "dl:" + key).
    { "name": "RL_DL_IP", "namespace_id": "1015", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_DL_KEY", "namespace_id": "1016", "simple": { "limit": 10, "period": 60 } }
  ],
  // FILE_QUOTA: one object per account (named by the account id) holding the file upload counts.
  "durable_objects": { "bindings": [{ "name": "FILE_QUOTA", "class_name": "FileQuota" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FileQuota"] }],
  "vars": {
    "PA_ALLOWED_PUSH_ENDPOINTS": "[{\"host\":\"google.com\",\"paths\":[\"/fcm/send/\",\"/wp/\"]},{\"suffix\":\".google.com\",\"paths\":[\"/fcm/send/\",\"/wp/\"]},{\"host\":\"googleapis.com\",\"paths\":[\"/fcm/send/\",\"/wp/\"]},{\"suffix\":\".googleapis.com\",\"paths\":[\"/fcm/send/\",\"/wp/\"]},{\"suffix\":\".push.services.mozilla.com\",\"paths\":[\"/wpush/\"]},{\"suffix\":\".notify.windows.com\",\"paths\":[\"/w/\"]},{\"suffix\":\".push.apple.com\",\"paths\":[\"/\"]}]",
    "PA_ALLOWED_UP_HOSTS": "[\"ntfy.sh\",\"updates.push.services.mozilla.com\"]",
    "PA_PUSH_TTL_SECONDS": "604800",
    "CLOUDFLARE_TURNSTILE_HOSTNAME": "pusharmor.com",
    "CLOUDFLARE_TURNSTILE_ACTION": "email",
    "PA_OAUTH_REDIRECT_FIREFOX": "https://pusharmor.com/auth/done",
    "PA_OAUTH_REDIRECT_ANDROID": "https://pusharmor.com/auth/android",
    "PA_OAUTH_REDIRECT_WEB": "https://pusharmor.com/delete-account",
    "PA_OAUTH_REDIRECT_CLI": "https://pusharmor.com/auth/cli",
    "PA_WEB_ORIGINS": "[\"https://pusharmor.com\"]",
    "B2_BUCKET": "pusharmor-files",
    "B2_S3_ENDPOINT": "https://s3.us-east-005.backblazeb2.com",
    "B2_REGION": "us-east-005"
  }
}
