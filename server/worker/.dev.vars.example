# Secret names for local "wrangler dev" (copy to .dev.vars, which is git-ignored).
# Production values are set with "wrangler secret put NAME"; never commit them.
# HMAC secrets are b64url strings of at least 32 random bytes.
PA_ID_SECRET=
PA_CODE_SECRET=
PA_CONFIRM_SECRET=
PA_TOKEN_SECRET=
CLOUDFLARE_TURNSTILE_SECRET=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
GOOGLE_FCM_SA_EMAIL=
GOOGLE_FCM_SA_KEY_ID=
GOOGLE_FCM_SA_PRIVATE_KEY=
APPLE_APNS_KEY_P8=
WEBPUSH_VAPID_PRIVATE_KEY=
GOOGLE_CLIENT_SECRET=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_KEY_P8=
# Deployment ids: Cloudflare dashboard variables in production (not in wrangler.jsonc).
GOOGLE_FCM_PROJECT_ID=
APPLE_APNS_TOPIC=
APPLE_APNS_KEY_ID=
APPLE_APNS_TEAM_ID=
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_SUB=
AWS_SES_REGION=
AWS_SES_MAIL_FROM=
AWS_SES_CONFIG_SET=
GOOGLE_AUD_WEB=[]
GOOGLE_AUD_NATIVE=[]
APPLE_SIGNIN_AUD_WEB=
APPLE_SIGNIN_AUD_NATIVE=
PA_OAUTH_REDIRECT_CHROME=
