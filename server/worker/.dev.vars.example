# Secret names for local "wrangler dev" (copy to .dev.vars, which is git-ignored).
# Production values are set with "wrangler secret put NAME"; never commit them.
# HMAC secrets are b64url strings of at least 32 random bytes.
ID_SECRET=
CODE_SECRET=
CONFIRM_SECRET=
TOKEN_SECRET=
TURNSTILE_SECRET=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
FCM_SA_EMAIL=
FCM_SA_KEY_ID=
FCM_SA_PRIVATE_KEY=
APNS_KEY_P8=
VAPID_PRIVATE_KEY=
GOOGLE_CLIENT_SECRET=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_KEY_P8=
# Deployment ids: Cloudflare dashboard variables in production (not in wrangler.jsonc).
FCM_PROJECT_ID=
APNS_TOPIC=
APNS_KEY_ID=
APNS_TEAM_ID=
VAPID_PUBLIC_KEY=
VAPID_SUB=
SES_REGION=
MAIL_FROM=
SES_CONFIG_SET=
GOOGLE_AUD_WEB=[]
GOOGLE_AUD_NATIVE=[]
APPLE_AUD_WEB=
APPLE_AUD_NATIVE=
OAUTH_REDIRECT_CHROME=
