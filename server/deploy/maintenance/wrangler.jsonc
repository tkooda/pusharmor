{
  "name": "pusharmor-api",
  "main": "index.js",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "keep_vars": true,
  "preview_urls": false,
  "routes": [{ "pattern": "api.pusharmor.com", "custom_domain": true }],
  "triggers": { "crons": ["0 3 1 * *"] },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
    "head_sampling_rate": 1
  }
}
